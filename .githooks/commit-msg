#!/bin/sh

set -eu

MSG_FILE="$1"
MSG=$(head -n 1 "$MSG_FILE" | tr -d '\r')

# Allow merge/revert commits created by Git.
case "$MSG" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

# Conventional/semantic commit format:
# type(scope)!: subject
# type!: subject
# type: subject
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?(!)?: .+$'

if printf '%s' "$MSG" | grep -Eq "$PATTERN"; then
  :
else
  cat <<'EOF'
ERROR: Commit message must follow semantic commit format.

Expected:
  type(scope): short summary
  type: short summary
  type!: short summary

Allowed types:
  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert

Examples:
  feat(router): add session controller extraction
  fix(cli): handle stale resume retry path
  chore: update release log links
EOF

  exit 1
fi

if grep -Eiq '^Signed-off-by:[[:space:]]+.+<.+>$' "$MSG_FILE"; then
  exit 0
fi

cat <<'EOF'
ERROR: Missing DCO sign-off.

Include a Signed-off-by trailer in each commit message, for example:
  Signed-off-by: Your Name <you@example.com>

Recommended command:
  git commit -s

If you already committed without sign-off:
  git commit --amend -s --no-edit
EOF

exit 1
