{
  "name": "model-switchboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "switchboard": "./bin/switchboard.js"
  },
  "scripts": {
    "test": "node --test",
    "check:anthropic": "node src/poc/cli.js anthropic-connection-check",
    "check:openai": "node src/poc/cli.js openai-connection-check",
    "check:gemini": "node src/poc/cli.js gemini-connection-check",
    "switchboard:turn": "node src/poc/switchboard_cli.js turn",
    "switchboard:continuity": "node src/poc/switchboard_cli.js continuity-probe --live true --no-tools true --inter-turn-delay-ms 1000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@google/genai": "^2.0.1",
    "openai": "^6.37.0"
  }
}
