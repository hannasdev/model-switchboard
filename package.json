{
  "name": "model-switchboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "poc:route": "node src/poc/cli.js route",
    "poc:fixtures": "node src/poc/cli.js fixtures",
    "poc:vendor-matrix": "node src/poc/cli.js vendor-matrix",
    "poc:mapping-check": "node src/poc/cli.js mapping-check",
    "poc:gateway-surface": "node src/poc/cli.js gateway-surface --vendor openai --input \"Implement the plan.\" --tool-action safe_file_edit",
    "poc:gateway-thread-turn": "node src/poc/cli.js gateway-thread-turn --vendor openai --thread-id poc-thread-1 --input \"Implement the plan.\"",
    "poc:release-gate": "node src/poc/cli.js release-gate",
    "poc:claude-cli-route": "node src/poc/cli.js claude-cli-route",
    "poc:claude-cli-live": "node src/poc/cli.js claude-cli-route --live true",
    "poc:claude-cli-model-probe": "node src/poc/cli.js claude-cli-route --live true --input \"Implement the plan. Do not use tools; reply exactly OK.\" --no-tools true",
    "poc:switchboard-turn": "node src/poc/switchboard_cli.js turn",
    "poc:switchboard-continuity": "node src/poc/switchboard_cli.js continuity-probe",
    "poc:switchboard-continuity-live": "node src/poc/switchboard_cli.js continuity-probe --live true --no-tools true --inter-turn-delay-ms 1000",
    "poc:openai-adapter-spike": "node src/poc/cli.js openai-adapter-spike",
    "poc:openai-adapter-live": "node src/poc/cli.js openai-adapter-spike --live true",
    "poc:openai-connection-check": "node src/poc/cli.js openai-connection-check",
    "poc:adapter-spike": "node src/poc/cli.js openai-adapter-spike",
    "poc:adapter-live": "node src/poc/cli.js openai-adapter-spike --live true",
    "poc:connection-check": "node src/poc/cli.js openai-connection-check",
    "poc:anthropic-adapter-spike": "node src/poc/cli.js anthropic-adapter-spike",
    "poc:anthropic-adapter-live": "node src/poc/cli.js anthropic-adapter-spike --live true",
    "poc:anthropic-connection-check": "node src/poc/cli.js anthropic-connection-check",
    "poc:gemini-adapter-spike": "node src/poc/cli.js gemini-adapter-spike",
    "poc:gemini-adapter-live": "node src/poc/cli.js gemini-adapter-spike --live true",
    "poc:gemini-connection-check": "node src/poc/cli.js gemini-connection-check",
    "poc:production-hook": "node src/poc/cli.js production-hook --vendor openai --tool-action read_file"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@google/genai": "^2.0.1",
    "openai": "^6.37.0"
  }
}
